{
  "name": "locturne",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "decode-uri-component": "file:./vendor/decode-uri-component",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "posthog-react-native": "^4.78.4",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-device-activity": "^0.6.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@babel/traverse": "7.29.8",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "node --test --experimental-test-module-mocks",
    "test:tz": "for tz in UTC America/New_York Europe/London Pacific/Chatham America/Santiago; do echo \"TZ=$tz\"; TZ=$tz npm test --silent || exit 1; done",
    "test:native": "native-tests/run.sh",
    "test:native:tz": "for tz in UTC America/New_York Europe/London Pacific/Chatham America/Santiago; do echo \"TZ=$tz\"; out=$(TZ=$tz native-tests/run.sh) || { echo \"$out\"; exit 1; }; echo \"$out\" | tail -1; done"
  },
  "private": true,
  "overrides": {
    "@xmldom/xmldom@<0.8.15": "0.8.15",
    "uuid@<11.1.1": "11.1.1",
    "decode-uri-component": "$decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    },
    "react-native-device-activity": {
      "@xmldom/xmldom": "0.8.15"
    }
  }
}
