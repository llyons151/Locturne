{
  "expo": {
    "name": "Locturne",
    "slug": "locturne",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "locturne",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.lukelyons.locturne",
      "icon": "./assets/expo.icon",
      "appleTeamId": "9N5WZT8LV3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "./plugins/with-local-notifications-only",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Locturne uses the camera to scan your wake-up code in the morning. Nothing is recorded or saved.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Locturne checks your steps and stairs each morning to wake your apps. That’s all it uses motion for."
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "9N5WZT8LV3",
          "appGroup": "group.com.lukelyons.locturne",
          "copyToTargetFolder": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "revenueCat": {
        "appleApiKey": "REPLACE_WITH_REVENUECAT_PUBLIC_APPLE_KEY",
        "simulateAskToBuy": false
      },
      "eas": {
        "projectId": "f2cf242c-0db6-467f-9e18-1f8a6ccec61a",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.lukelyons.locturne.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.lukelyons.locturne"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.lukelyons.locturne.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.lukelyons.locturne"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.lukelyons.locturne.DeviceActivityMonitor",
                  "targetName": "ActivityMonitorExtension",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.lukelyons.locturne"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "llyons151"
  }
}
