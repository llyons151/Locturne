    "shield.cantRead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can’t read your steps from here. Open Locturne and I’ll check."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde aquí no puedo leer tus pasos. Abre Locturne y lo compruebo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von hier aus kann ich deine Schritte nicht lesen. Öffne Locturne, dann prüfe ich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’ici, je ne peux pas lire tes pas. Ouvre Locturne et je vérifie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Daqui não consigo ler seus passos. Abra o Locturne que eu confiro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここからだと歩数が読めない。Locturneを開いたら確認する。"
          }
        }
      }
    },
    "shield.early": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up early. Steps count from {clock}. Tap I’m up after that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muy temprano. Los pasos cuentan desde las {clock}. Toca Ya estoy de pie después."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früh dran. Schritte zählen ab {clock}. Tippe danach auf Ich bin auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien tôt. Les pas comptent à partir de {clock}. Touche Je suis debout après."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cedo demais. Os passos contam a partir das {clock}. Toque em Já levantei depois disso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早すぎる。歩数は{clock}から数える。そのあと「起きた」をタップ。"
          }
        }
      }
    },
    "shield.inApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This one’s in Locturne. Open it and I’ll wake them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se hace en Locturne. Ábrelo y las despierto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das läuft in Locturne. Öffne es, dann wecke ich sie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça se passe dans Locturne. Ouvre-le et je les réveille."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é no Locturne. Abra que eu acordo eles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはLocturneでやる。開いたら起こす。"
          }
        }
      }
    },
    "shield.stepsLeft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{steps} of {goal} steps. {left} more, then tap I’m up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{steps} de {goal} pasos. Faltan {left}, luego toca Ya estoy de pie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{steps} von {goal} Schritten. Noch {left}, dann tippe auf Ich bin auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{steps} pas sur {goal}. Encore {left}, puis touche Je suis debout."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{steps} de {goal} passos. Faltam {left}, depois toque em Já levantei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{goal}歩中{steps}歩。あと{left}歩歩いたら「起きた」をタップ。"
          }
        }
      }
    },
    "shield.timerPastBedtime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your timer runs past bedtime, so they sleep through to tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu temporizador pasa de la hora de dormir, así que duermen hasta mañana."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Timer läuft über die Schlafenszeit hinaus, also schlafen sie bis morgen durch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton minuteur dépasse l’heure du coucher, donc elles dorment jusqu’à demain."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu timer passa da hora de dormir, então eles dormem até amanhã."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマーが就寝時間を過ぎるから、明日まで寝たままだ。"
          }
        }
      }
    },
    "shield.timerRunning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer’s running. They wake at {clock}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El temporizador corre. Se despiertan a las {clock}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Timer läuft. Sie wachen um {clock} auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le minuteur tourne. Elles se réveillent à {clock}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O timer está correndo. Eles acordam às {clock}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマー作動中。{clock}に起きる。"
          }
        }
      }
    },
