          "stringUnit": {
            "state": "translated",
            "value": "データが届くと、スクリーンタイムがここに表示されます。"
          }
        }
      }
    },
    "report.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage is reported by Screen Time. Totals add up time in apps, so they can be lower than Settings, which also counts the lock screen. Phone and FaceTime calls aren’t counted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El uso lo informa Tiempo de uso. Los totales suman el tiempo en apps, así que pueden ser menores que en Ajustes, que también cuenta la pantalla bloqueada. Las llamadas de Teléfono y FaceTime no cuentan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nutzung meldet Bildschirmzeit. Die Summen zählen nur die Zeit in Apps und können daher niedriger sein als in den Einstellungen, die auch den Sperrbildschirm mitzählen. Telefon- und FaceTime-Anrufe zählen nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilisation est fournie par Temps d’écran. Les totaux additionnent le temps dans les apps et peuvent donc être plus bas que dans Réglages, qui compte aussi l’écran verrouillé. Les appels Téléphone et FaceTime ne comptent pas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O uso vem do Tempo de Uso. Os totais somam o tempo nos apps, então podem ser menores que nos Ajustes, que também contam a tela bloqueada. Ligações do Telefone e do FaceTime não contam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用状況はスクリーンタイムから届きます。合計はアプリ内の時間だけなので、ロック画面も数える「設定」より少なくなることがあります。電話とFaceTimeの通話は含みません。"
          }
        }
      }
    },
