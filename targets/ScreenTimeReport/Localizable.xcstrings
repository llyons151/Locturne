        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Durchschnitt nutzt {count} Tag mit Daten. Fehlende Tage bleiben leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La moyenne utilise {count} jour avec données. Les jours manquants restent vides."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A média usa {count} dia com dados. Dias sem dados ficam em branco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平均はデータのある{count}日分です。データのない日は空白です。"
