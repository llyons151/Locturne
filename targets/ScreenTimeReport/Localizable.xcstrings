    "report.averageUses.one": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average uses {count} day with data. Missing days are left blank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La media usa {count} día con datos. Los días sin datos quedan en blanco."
