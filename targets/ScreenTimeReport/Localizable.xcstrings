    "shield.asleepFor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asleep for {time} more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormidas {time} más."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schläft noch {time}."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Endormie encore {time}."
          }
        },
        "pt-BR": {
