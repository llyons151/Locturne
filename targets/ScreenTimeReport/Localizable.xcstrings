    "report.emptyCompact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your screen time will appear here when data is available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tiempo de uso aparecerá aquí cuando haya datos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bildschirmzeit erscheint hier, sobald Daten da sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton temps d’écran apparaîtra ici quand des données seront disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu tempo de uso vai aparecer aqui quando houver dados."
          }
        },
